PORT=5000
NODE_ENV=development

SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Email — Primary: Resend (recommended for deliverability)
RESEND_API_KEY=

# Email — Sender identity (used by both Resend and Gmail fallback)
EMAIL_FROM=admin@behindthebuild.in
EMAIL_REPLY_TO=admin@behindthebuild.in
EMAIL_TEAM_TO=admin@behindthebuild.in

# Email — Gmail SMTP fallback (used only when RESEND_API_KEY is not set)
EMAIL_USER=
EMAIL_PASS=

# Note: VITE_API_URL is NOT needed — the app uses relative URLs (/api/*)
# which route through Vite proxy in dev and Vercel serverless in production.
FRONTEND_URL=http://localhost:5173
