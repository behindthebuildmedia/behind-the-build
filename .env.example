PORT=5000
NODE_ENV=development

SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Email — Primary: Zoho SMTP (recommended — DNS already configured for behindthebuild.in)
# Create an app-specific password at: Zoho Mail → Settings → Security → App Passwords
ZOHO_USER=admin@behindthebuild.in
ZOHO_PASS=your-zoho-app-password-here

# Email — Sender identity
EMAIL_FROM=admin@behindthebuild.in
EMAIL_REPLY_TO=admin@behindthebuild.in
EMAIL_TEAM_TO=admin@behindthebuild.in

# Email — Gmail SMTP (NOT recommended — sends from Gmail address, likely spam)
# Only use for local dev if Zoho/Resend unavailable
EMAIL_USER=
EMAIL_PASS=

# Note: VITE_API_URL is NOT needed — the app uses relative URLs (/api/*)
# which route through Vite proxy in dev and Vercel serverless in production.
FRONTEND_URL=http://localhost:5173
